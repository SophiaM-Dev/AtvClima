@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

<form method="post">

    <div>
        <label>E-mail</label>
        <input name="email"
               type="email"
               id="email" />
    </div>

    <div>
        <label>Senha</label>
        <input name="password"
               type="password"
               id="password" />
    </div>

    <button type="submit"
            id="loginButton">
        Entrar
    </button>

</form>

@if (ViewBag.Error != null)
{
    <div id="error">
        @ViewBag.Error
    </div>
}